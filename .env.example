# ==============================================================================
# NL2DB Platform Environment Configuration
# ==============================================================================

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# NVIDIA NIM Configuration
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here
NVIDIA_NIM_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_NIM_TIMEOUT_SECONDS=30
NVIDIA_NIM_TEMPERATURE=0.1
# Set to true to use built-in mock LLM for offline testing without burning API credits
USE_MOCK_LLM=false

# Query Execution Safety Guardrails
MAX_QUERY_TIMEOUT_SECONDS=5
DEFAULT_ROW_LIMIT=50
HARD_MAX_ROWS=500
MAX_RECOVERY_RETRIES=2

# Local Database Connections (Testing & Querying)
# 1. MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=nl2db_test

# 2. PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DATABASE=nl2db_test

# 3. MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=nl2db_test

# 4. SQLite (Default fallback / sample)
SQLITE_DB_PATH=./data/nl2db_sample.db
